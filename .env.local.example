# Backend authentication and runtime settings.
# Clerk development secret key used by the backend to verify user authentication.
CLERK_SECRET_KEY=
# Comma-separated local browser origins allowed to call the backend.
CORS_ORIGINS=
# SQLite connection string. docker-compose.yml pins this to the container path
# for the backend service; set it here only when running the backend outside Docker.
DATABASE_URL=sqlite+aiosqlite:///./data/applitrack.db
# Runtime mode for local development.
ENVIRONMENT=

# Cloudflare R2 object storage settings for application attachments.
R2_ACCESS_KEY_ID=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
# The backend derives its R2 endpoint from R2_ACCOUNT_ID; this is retained for tooling compatibility.
R2_ENDPOINT=
R2_SECRET_ACCESS_KEY=
R2_USER_TOKEN=

# Public local site URL used for application links and redirects.
SITE_URL=

# Frontend build-time variables exposed to the Vite application.
# Local backend API base URL.
VITE_API_URL=
# Clerk publishable key used by the frontend authentication client.
VITE_CLERK_PUBLISHABLE_KEY=
# Frontend routes used by Clerk sign-in and sign-up flows.
VITE_CLERK_SIGN_IN_URL=
VITE_CLERK_SIGN_UP_URL=
# Fallback routes after successful sign-in and sign-up.
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=