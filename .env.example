# Cloudflare Access credentials for authenticated deployment requests.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Backend authentication and runtime settings.
# Clerk secret key used by the backend to verify user authentication.
CLERK_SECRET_KEY=
# Comma-separated browser origins allowed to call the backend; also used for Clerk authorized parties.
CORS_ORIGINS=
# PostgreSQL connection components used by the database service and healthcheck.
DATABASE_HOST=
DATABASE_NAME=
DATABASE_PASSWORD=
DATABASE_PORT=
DATABASE_USER=
# Complete PostgreSQL connection string used by the backend and migrations.
DATABASE_URL=
# Runtime mode, such as development, testing, or production.
ENVIRONMENT=

# Docker image publishing credentials used by CI.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Dokploy deployment hook URLs for the backend and frontend services.
DOKPLOY_BACKEND_DEPLOY_HOOK_URL=
DOKPLOY_FRONTEND_DEPLOY_HOOK_URL=

# Frontend service settings.
# Port exposed by the frontend service in deployment.
FRONTEND_PORT=
# Public site URL used for canonical application links and redirects.
SITE_URL=

# Cloudflare R2 object storage settings for application attachments.
# S3-compatible access key for the R2 bucket.
R2_ACCESS_KEY_ID=
# Cloudflare account identifier used to build the R2 endpoint.
R2_ACCOUNT_ID=
# R2 bucket used to store attachments.
R2_BUCKET_NAME=
# Optional explicit R2 endpoint; the backend currently derives it from R2_ACCOUNT_ID.
R2_ENDPOINT=
# S3-compatible secret key for the R2 bucket.
R2_SECRET_ACCESS_KEY=
# Cloudflare API token for R2 management operations, when required by deployment tooling.
R2_USER_TOKEN=

# Frontend build-time variables exposed to the Vite application.
# Base URL used by the frontend to call the backend API.
VITE_API_URL=
# Clerk publishable key used by the frontend authentication client.
VITE_CLERK_PUBLISHABLE_KEY=
# Frontend route shown for sign-in.
VITE_CLERK_SIGN_IN_URL=
# Frontend route shown for sign-up.
VITE_CLERK_SIGN_UP_URL=
# Fallback route after a successful sign-in.
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
# Fallback route after a successful sign-up.
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=