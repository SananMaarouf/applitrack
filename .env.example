# Frontend build-time variables. Vite inlines these into the bundle, so they must
# be set when running `npm run build`.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Optional. Defaults to the relative /api, which is correct whenever the SPA and
# the Worker are served from the same origin. Only set it if they are not.
# VITE_API_URL=

# The API's secrets are not read from this file. They are set on the Worker with
# `wrangler secret put` — CLERK_SECRET_KEY, CLERK_PUBLISHABLE_KEY,
# ATTACHMENT_SIGNING_KEY — and for local development in worker/.dev.vars
# (see worker/.dev.vars.example and worker/README.md).
