{
  "name": "applitrack",
  "private": true,
  "workspaces": [
    "frontend",
    "worker"
  ],
  "scripts": {
    "dev": "npm run db:migrate:local --workspace worker && concurrently --kill-others --names worker,frontend --prefix-colors yellow,cyan \"npm:dev:worker\" \"npm:dev:frontend\"",
    "dev:worker": "npm run dev --workspace worker -- --port 8787 --assets ../frontend/public",
    "dev:frontend": "npm run dev --workspace frontend",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace worker",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "changeset:status": "changeset status",
    "worker:dev": "npm run dev --workspace worker",
    "worker:test": "npm run test --workspace worker",
    "worker:typecheck": "npm run typecheck --workspace worker",
    "worker:deploy": "npm run deploy --workspace worker"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "concurrently": "^10.0.7",
    "shadcn": "^4.0.2"
  }
}
